PORT=3005

# TastyTrade OAuth credentials (required for market data)
# See: https://developer.tastytrade.com/oauth/
TASTYTRADE_CLIENT_SECRET=your-oauth-client-secret
TASTYTRADE_REFRESH_TOKEN=your-oauth-refresh-token
TASTYTRADE_OAUTH_SCOPES=read trade

# Set to "true" to use the TastyTrade sandbox (cert) environment
TASTYTRADE_SANDBOX=false

# Metrics cache TTL in seconds (default: 5 minutes)
METRICS_CACHE_TTL_SECONDS=300

# Candle cache TTL in minutes (default: 15 minutes for intraday, 60 for daily)
CANDLE_CACHE_TTL_MINUTES=15

# Minimum composite score for a symbol to stay in the universe (0.0-1.0)
MIN_UNIVERSE_SCORE=0.4

# Cron schedule for universe scoring (default: 8am Mon-Fri)
UNIVERSE_SCAN_CRON="0 8 * * 1-5"
